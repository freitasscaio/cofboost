<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Overclutch" Width="1180" Height="760" MinWidth="1000" MinHeight="640"
        WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanResize"
        Background="#0D1220" Foreground="#E6EBF5"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="13" UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">
  <WindowChrome.WindowChrome>
    <WindowChrome CaptionHeight="46" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
  </WindowChrome.WindowChrome>

  <Window.Resources>
    <FontFamily x:Key="Display">Segoe UI Variable Display, Segoe UI</FontFamily>
    <SolidColorBrush x:Key="Panel" Color="#131A2B"/>
    <SolidColorBrush x:Key="PanelBorder" Color="#1F2940"/>
    <SolidColorBrush x:Key="Muted" Color="#8C97AE"/>
    <SolidColorBrush x:Key="Violet" Color="#8B5CF6"/>
    <SolidColorBrush x:Key="VioletHi" Color="#A78BFA"/>
    <SolidColorBrush x:Key="Stable" Color="#5BF0B0"/>

    <!-- Ícones de linha desenhados em uma grade 24x24 -->
    <Style x:Key="Icon" TargetType="Path">
      <Setter Property="StrokeThickness" Value="1.8"/>
      <Setter Property="StrokeLineJoin" Value="Round"/>
      <Setter Property="StrokeStartLineCap" Value="Round"/>
      <Setter Property="StrokeEndLineCap" Value="Round"/>
      <Setter Property="Fill" Value="Transparent"/>
    </Style>

    <Style x:Key="NavButton" TargetType="Button">
      <Setter Property="Foreground" Value="#9AA4BA"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="Height" Value="44"/>
      <Setter Property="Margin" Value="12,2"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Grid>
              <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="10" Padding="14,0">
                <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Left"/>
              </Border>
              <!-- Indicador da página ativa (a cor vem de BorderBrush) -->
              <Border Width="3" Height="20" CornerRadius="2" HorizontalAlignment="Left" Margin="-12,0,0,0" Background="{TemplateBinding BorderBrush}"/>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="#18203A"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="CaptionButton" TargetType="Button">
      <Setter Property="Width" Value="46"/>
      <Setter Property="Height" Value="46"/>
      <Setter Property="Foreground" Value="#9AA4BA"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bd" Background="{TemplateBinding Background}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="#1B2440"/>
                <Setter Property="Foreground" Value="White"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="CloseButton" TargetType="Button" BasedOn="{StaticResource CaptionButton}">
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bd" Background="Transparent">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="#C42B1C"/>
                <Setter Property="Foreground" Value="White"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="PrimaryButton" TargetType="Button">
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="Background" Value="#8B5CF6"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="Padding" Value="18,10"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="10" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Background" Value="#9B74F8"/></Trigger>
              <Trigger Property="IsPressed" Value="True"><Setter TargetName="Bd" Property="Background" Value="#7A4AEA"/></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Bd" Property="Opacity" Value="0.45"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="SecondaryButton" TargetType="Button">
      <Setter Property="Foreground" Value="#E6EBF5"/>
      <Setter Property="Background" Value="#1A2236"/>
      <Setter Property="BorderBrush" Value="#26314B"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="Padding" Value="16,9"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="1" CornerRadius="10" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Background" Value="#222C46"/></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Bd" Property="Opacity" Value="0.45"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="SocialButton" TargetType="Button">
      <Setter Property="Width" Value="34"/>
      <Setter Property="Height" Value="34"/>
      <Setter Property="Foreground" Value="#7C88A3"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bd" Background="Transparent" CornerRadius="9">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="#18203A"/>
                <Setter Property="Foreground" Value="#C4B5FD"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="Toggle" TargetType="CheckBox">
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="CheckBox">
            <Border x:Name="Track" Width="46" Height="26" CornerRadius="13" Background="#26314B">
              <Ellipse x:Name="Knob" Width="20" Height="20" Fill="#C9D2E6" HorizontalAlignment="Left" Margin="3,0"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Track" Property="Background" Value="#8B5CF6"/>
                <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right"/>
                <Setter TargetName="Knob" Property="Fill" Value="White"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="SelectBox" TargetType="CheckBox">
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="CheckBox">
            <Border x:Name="Box" Width="22" Height="22" CornerRadius="6" Background="#0E1424" BorderBrush="#34405E" BorderThickness="1.5">
              <Path x:Name="Mark" Data="M 5,11 L 9,15 L 17,6" Stroke="White" StrokeThickness="2.4"
                    StrokeStartLineCap="Round" StrokeEndLineCap="Round" Visibility="Collapsed"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Box" Property="Background" Value="#8B5CF6"/>
                <Setter TargetName="Box" Property="BorderBrush" Value="#8B5CF6"/>
                <Setter TargetName="Mark" Property="Visibility" Value="Visible"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="CardStyle" TargetType="Border">
      <Setter Property="Background" Value="{StaticResource Panel}"/>
      <Setter Property="BorderBrush" Value="{StaticResource PanelBorder}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="14"/>
      <Setter Property="Padding" Value="20"/>
    </Style>
    <Style x:Key="IconTile" TargetType="Border">
      <Setter Property="Width" Value="40"/>
      <Setter Property="Height" Value="40"/>
      <Setter Property="CornerRadius" Value="11"/>
    </Style>
    <Style x:Key="Chip" TargetType="Border">
      <Setter Property="CornerRadius" Value="7"/>
      <Setter Property="Padding" Value="8,3"/>
      <Setter Property="HorizontalAlignment" Value="Right"/>
      <Setter Property="VerticalAlignment" Value="Top"/>
    </Style>

    <Style x:Key="H1" TargetType="TextBlock">
      <Setter Property="FontFamily" Value="{DynamicResource Display}"/>
      <Setter Property="FontSize" Value="28"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Foreground" Value="White"/>
    </Style>
    <Style x:Key="H2" TargetType="TextBlock">
      <Setter Property="FontFamily" Value="{DynamicResource Display}"/>
      <Setter Property="FontSize" Value="17"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Foreground" Value="White"/>
    </Style>
    <Style x:Key="Sub" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource Muted}"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
      <Setter Property="FontSize" Value="13.5"/>
      <Setter Property="Margin" Value="0,6,0,22"/>
    </Style>
    <Style x:Key="Label" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource Muted}"/>
      <Setter Property="FontSize" Value="12.5"/>
    </Style>
    <Style x:Key="Value" TargetType="TextBlock">
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="FontSize" Value="15"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    </Style>
    <Style x:Key="RowLabel" TargetType="TextBlock" BasedOn="{StaticResource Label}">
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style x:Key="RowValue" TargetType="TextBlock">
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="HorizontalAlignment" Value="Right"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    </Style>

    <!-- Barra de rolagem fina e escura -->
    <Style TargetType="ScrollBar">
      <Setter Property="Width" Value="10"/>
      <Setter Property="MinWidth" Value="10"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ScrollBar">
            <Grid Background="Transparent">
              <Track x:Name="PART_Track" IsDirectionReversed="True">
                <Track.Thumb>
                  <Thumb>
                    <Thumb.Template>
                      <ControlTemplate TargetType="Thumb">
                        <Border x:Name="T" Background="#2A3552" CornerRadius="4" Margin="2,0"/>
                        <ControlTemplate.Triggers>
                          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="T" Property="Background" Value="#3A4770"/></Trigger>
                        </ControlTemplate.Triggers>
                      </ControlTemplate>
                    </Thumb.Template>
                  </Thumb>
                </Track.Thumb>
              </Track>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <Border x:Name="RootBorder" BorderBrush="#1F2940" BorderThickness="1">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="46"/>
        <RowDefinition Height="*"/>
      </Grid.RowDefinitions>

      <!-- Barra de título -->
      <Grid Grid.Row="0" Background="#0A0F1B">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="18,0,0,0">
          <Image x:Name="TitleLogo" Width="22" Height="22"/>
          <TextBlock Text="Overclutch" FontFamily="{DynamicResource Display}" FontWeight="SemiBold" FontSize="15" Foreground="White" Margin="10,0,0,0" VerticalAlignment="Center"/>
          <Border x:Name="ModeBadge" CornerRadius="6" Padding="8,2" Margin="12,0,0,0" Background="#3A2A0A" Visibility="Collapsed" VerticalAlignment="Center">
            <TextBlock Text="Modo simulação" Foreground="#FBBF24" FontSize="11.5" FontWeight="SemiBold"/>
          </Border>
        </StackPanel>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
          <Button x:Name="BtnMin" Style="{StaticResource CaptionButton}" ToolTip="Minimizar">
            <Path Data="M 0,0 L 10,0" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.2"/>
          </Button>
          <Button x:Name="BtnMax" Style="{StaticResource CaptionButton}" ToolTip="Maximizar">
            <Rectangle Width="10" Height="10" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.2"/>
          </Button>
          <Button x:Name="BtnClose" Style="{StaticResource CloseButton}" ToolTip="Fechar">
            <Path Data="M 0,0 L 10,10 M 10,0 L 0,10" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.2"/>
          </Button>
        </StackPanel>
      </Grid>

      <Grid Grid.Row="1">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="232"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Menu lateral -->
        <Border Grid.Column="0" Background="#0A0F1B" BorderBrush="#161E32" BorderThickness="0,0,1,0">
          <DockPanel Margin="0,14,0,0">
            <StackPanel DockPanel.Dock="Bottom" Margin="22,0,22,20">
              <!-- Redes sociais: link vazio em $script:Links (Core.ps1) esconde o ícone -->
              <StackPanel Orientation="Horizontal" Margin="-6,0,0,12">
                <Button x:Name="LinkInstagram" Style="{StaticResource SocialButton}" ToolTip="Instagram">
                  <Viewbox Width="18" Height="18"><Grid Width="24" Height="24"><Path Style="{StaticResource Icon}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Data="M7 3 H17 A4 4 0 0 1 21 7 V17 A4 4 0 0 1 17 21 H7 A4 4 0 0 1 3 17 V7 A4 4 0 0 1 7 3 Z M8 12 A4 4 0 1 0 16 12 A4 4 0 1 0 8 12 Z M17.4 6.6 H17.5"/></Grid></Viewbox>
                </Button>
                <Button x:Name="LinkYouTube" Style="{StaticResource SocialButton}" ToolTip="YouTube">
                  <Viewbox Width="18" Height="18"><Grid Width="24" Height="24"><Path Style="{StaticResource Icon}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Data="M4 6.5 C7 5.6 17 5.6 20 6.5 C21.3 6.9 21.8 8.5 21.8 12 C21.8 15.5 21.3 17.1 20 17.5 C17 18.4 7 18.4 4 17.5 C2.7 17.1 2.2 15.5 2.2 12 C2.2 8.5 2.7 6.9 4 6.5 Z M10 9 L15 12 L10 15 Z"/></Grid></Viewbox>
                </Button>
                <Button x:Name="LinkDiscord" Style="{StaticResource SocialButton}" ToolTip="Discord">
                  <Viewbox Width="18" Height="18"><Grid Width="24" Height="24"><Path Style="{StaticResource Icon}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Data="M8.5 5.5 C6.6 5.9 5.1 6.5 3.8 7.4 C2.1 10.2 1.6 13.2 2.1 16.2 C3.6 17.4 5.2 18.1 6.9 18.5 L8 16.6 M16 16.6 L17.1 18.5 C18.8 18.1 20.4 17.4 21.9 16.2 C22.4 13.2 21.9 10.2 20.2 7.4 C18.9 6.5 17.4 5.9 15.5 5.5 M6.6 16 C10 17.6 14 17.6 17.4 16 M7.4 7.3 C10.4 6.3 13.6 6.3 16.6 7.3 M7.9 12.3 A1.3 1.3 0 1 0 10.5 12.3 A1.3 1.3 0 1 0 7.9 12.3 Z M13.5 12.3 A1.3 1.3 0 1 0 16.1 12.3 A1.3 1.3 0 1 0 13.5 12.3 Z"/></Grid></Viewbox>
                </Button>
                <Button x:Name="LinkGitHub" Style="{StaticResource SocialButton}" ToolTip="Código no GitHub">
                  <Viewbox Width="18" Height="18"><Grid Width="24" Height="24"><Path Style="{StaticResource Icon}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Data="M9 8 L5 12 L9 16 M15 8 L19 12 L15 16"/></Grid></Viewbox>
                </Button>
              </StackPanel>
              <TextBlock x:Name="ModeText" Text="Modo administrador" FontSize="11.5" Foreground="#5BF0B0" TextWrapping="Wrap"/>
              <TextBlock x:Name="VersionText" Text="v1.0.0" FontSize="11.5" Foreground="#5D6883" Margin="0,4,0,0"/>
            </StackPanel>
            <StackPanel>
              <Button x:Name="NavHome" Style="{StaticResource NavButton}">
                <StackPanel Orientation="Horizontal">
                  <Viewbox Width="18" Height="18"><Grid Width="24" Height="24"><Path Style="{StaticResource Icon}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Data="M3 10.5 L12 3 L21 10.5 V20 H15 V14 H9 V20 H3 Z"/></Grid></Viewbox>
                  <TextBlock Text="Painel" Margin="12,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
              </Button>
              <Button x:Name="NavTweaks" Style="{StaticResource NavButton}">
                <StackPanel Orientation="Horizontal">
                  <Viewbox Width="18" Height="18"><Grid Width="24" Height="24"><Path Style="{StaticResource Icon}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Data="M13 2 L3 14 H12 L11 22 L21 10 H12 Z"/></Grid></Viewbox>
                  <TextBlock Text="Otimizações" Margin="12,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
              </Button>
              <Button x:Name="NavClean" Style="{StaticResource NavButton}">
                <StackPanel Orientation="Horizontal">
                  <Viewbox Width="18" Height="18"><Grid Width="24" Height="24"><Path Style="{StaticResource Icon}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Data="M11 3 L12.8 8.2 L18 10 L12.8 11.8 L11 17 L9.2 11.8 L4 10 L9.2 8.2 Z M18.5 14.5 L19.3 16.7 L21.5 17.5 L19.3 18.3 L18.5 20.5 L17.7 18.3 L15.5 17.5 L17.7 16.7 Z"/></Grid></Viewbox>
                  <TextBlock Text="Limpeza" Margin="12,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
              </Button>
              <Button x:Name="NavRestore" Style="{StaticResource NavButton}">
                <StackPanel Orientation="Horizontal">
                  <Viewbox Width="18" Height="18"><Grid Width="24" Height="24"><Path Style="{StaticResource Icon}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Data="M12 3 L4 6 V12 C4 16.5 7.4 20.3 12 21 C16.6 20.3 20 16.5 20 12 V6 Z M9 12 L11 14 L15 10"/></Grid></Viewbox>
                  <TextBlock Text="Restauração" Margin="12,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
              </Button>
              <Button x:Name="NavSettings" Style="{StaticResource NavButton}">
                <StackPanel Orientation="Horizontal">
                  <Viewbox Width="18" Height="18"><Grid Width="24" Height="24"><Path Style="{StaticResource Icon}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Data="M4 6 H13 M17 6 H20 M4 12 H7 M11 12 H20 M4 18 H15 M19 18 H20 M15 4 V8 M9 10 V14 M17 16 V20"/></Grid></Viewbox>
                  <TextBlock Text="Configurações" Margin="12,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
              </Button>
            </StackPanel>
          </DockPanel>
        </Border>

        <!-- Conteúdo -->
        <Grid Grid.Column="1">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>

          <!-- Faixa de atualização: aparece quando há versão nova no GitHub -->
          <Border x:Name="UpdateBanner" Grid.Row="0" Visibility="Collapsed" Margin="36,20,36,0" Padding="18,12"
                  CornerRadius="12" Background="#1D1838" BorderBrush="#8B5CF6" BorderThickness="1">
            <DockPanel>
              <Button x:Name="BtnUpdateNow" DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Padding="16,8" Content="Atualizar agora"/>
              <Button x:Name="BtnUpdateLater" DockPanel.Dock="Right" Style="{StaticResource SecondaryButton}" Padding="14,7" Margin="0,0,10,0" Content="Depois"/>
              <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                <TextBlock x:Name="UpdateTitle" Text="Nova versão disponível" Foreground="White" FontWeight="SemiBold" FontSize="14"/>
                <TextBlock x:Name="UpdateDetail" Text="" Foreground="#B8BDCC" FontSize="12" TextWrapping="Wrap"/>
              </StackPanel>
            </DockPanel>
          </Border>

          <Grid x:Name="ContentHost" Grid.Row="1" Margin="36,26,26,8">

            <!-- Painel -->
            <ScrollViewer x:Name="PageHome" VerticalScrollBarVisibility="Auto" Padding="0,0,10,0">
              <StackPanel Margin="0,0,0,16">
                <DockPanel>
                  <Border DockPanel.Dock="Right" VerticalAlignment="Top" CornerRadius="9" Padding="12,6" Background="#10281F">
                    <StackPanel Orientation="Horizontal">
                      <Ellipse Width="7" Height="7" Fill="#5BF0B0" VerticalAlignment="Center"/>
                      <TextBlock x:Name="StatusPillText" Text="0 de 20 ajustes ativos" Foreground="#5BF0B0" FontSize="12" FontWeight="SemiBold" Margin="8,0,0,0"/>
                    </StackPanel>
                  </Border>
                  <StackPanel>
                    <TextBlock x:Name="GreetingText" Style="{StaticResource H1}" Text="Olá"/>
                    <TextBlock Style="{StaticResource Sub}" Text="Visão geral do seu PC e do que o Overclutch já ajustou."/>
                  </StackPanel>
                </DockPanel>

                <!-- Cartão principal: anel de progresso + otimizar -->
                <Border CornerRadius="16" Padding="26" BorderBrush="#2E2459" BorderThickness="1">
                  <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                      <GradientStop Color="#231B47" Offset="0"/>
                      <GradientStop Color="#141A2E" Offset="0.7"/>
                    </LinearGradientBrush>
                  </Border.Background>
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto"/>
                      <ColumnDefinition Width="*"/>
                      <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid Grid.Column="0" Width="124" Height="124">
                      <Ellipse Stroke="#262F4D" StrokeThickness="10"/>
                      <Path x:Name="ScoreArc" StrokeThickness="10" StrokeStartLineCap="Round" StrokeEndLineCap="Round">
                        <Path.Stroke>
                          <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#A78BFA" Offset="0"/>
                            <GradientStop Color="#5BF0B0" Offset="1"/>
                          </LinearGradientBrush>
                        </Path.Stroke>
                      </Path>
                      <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock x:Name="ScoreText" Text="0%" FontFamily="{DynamicResource Display}" FontSize="30" FontWeight="SemiBold" Foreground="White" HorizontalAlignment="Center"/>
                        <TextBlock Text="otimizado" FontSize="11.5" Foreground="{StaticResource Muted}" HorizontalAlignment="Center"/>
                      </StackPanel>
                    </Grid>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="26,0,20,0">
                      <TextBlock Style="{StaticResource H2}" FontSize="21" Text="Otimize seu PC em um clique"/>
                      <TextBlock x:Name="ScoreDetail" Text="0 de 20 ajustes ativos" Foreground="#C4B5FD" FontSize="13" Margin="0,6,0,0"/>
                      <TextBlock Foreground="{StaticResource Muted}" FontSize="12.5" TextWrapping="Wrap" Margin="0,8,0,0"
                                 Text="Cria um ponto de restauração, salva os valores originais e aplica os ajustes recomendados. Dá para desfazer tudo depois."/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" VerticalAlignment="Center" Width="230">
                      <Button x:Name="BtnBoost" Style="{StaticResource PrimaryButton}" Height="50" FontSize="15">
                        <StackPanel Orientation="Horizontal">
                          <Viewbox Width="18" Height="18"><Grid Width="24" Height="24"><Path Style="{StaticResource Icon}" Stroke="White" StrokeThickness="2.2" Data="M13 2 L3 14 H12 L11 22 L21 10 H12 Z"/></Grid></Viewbox>
                          <TextBlock Text="Otimizar agora" Margin="10,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                      </Button>
                      <Button x:Name="BtnUndoAll" Style="{StaticResource SecondaryButton}" Margin="0,10,0,0" Content="Desfazer todas as otimizações"/>
                    </StackPanel>
                  </Grid>
                </Border>

                <!-- Hardware -->
                <UniformGrid Columns="4" Margin="0,16,0,0">
                  <Border Style="{StaticResource CardStyle}" Margin="0,0,8,0">
                    <Grid>
                      <Border Style="{StaticResource IconTile}" Background="#172748" HorizontalAlignment="Left" VerticalAlignment="Top">
                        <Viewbox Width="20" Height="20"><Grid Width="24" Height="24"><Path Style="{StaticResource Icon}" Stroke="#60A5FA" Data="M6 4 H18 A2 2 0 0 1 20 6 V18 A2 2 0 0 1 18 20 H6 A2 2 0 0 1 4 18 V6 A2 2 0 0 1 6 4 Z M9 9 H15 V15 H9 Z M9 1.5 V4 M15 1.5 V4 M9 20 V22.5 M15 20 V22.5 M1.5 9 H4 M1.5 15 H4 M20 9 H22.5 M20 15 H22.5"/></Grid></Viewbox>
                      </Border>
                      <Border Style="{StaticResource Chip}" Background="#172748"><TextBlock x:Name="CpuChip" Text="" Foreground="#60A5FA" FontSize="11" FontWeight="SemiBold"/></Border>
                      <StackPanel Margin="0,56,0,0">
                        <TextBlock Style="{StaticResource Label}" Text="Processador"/>
                        <TextBlock x:Name="CpuText" Style="{StaticResource Value}" Text="..." Margin="0,3,0,0"/>
                      </StackPanel>
                    </Grid>
                  </Border>
                  <Border Style="{StaticResource CardStyle}" Margin="4,0">
                    <Grid>
                      <Border Style="{StaticResource IconTile}" Background="#12302A" HorizontalAlignment="Left" VerticalAlignment="Top">
                        <Viewbox Width="20" Height="20"><Grid Width="24" Height="24"><Path Style="{StaticResource Icon}" Stroke="#5BF0B0" Data="M2 7 H22 V17 H2 Z M6 17 V20 M10 17 V20 M7 12 A2 2 0 1 0 11 12 A2 2 0 1 0 7 12 Z M14 10.5 H18 M14 13.5 H18"/></Grid></Viewbox>
                      </Border>
                      <Border Style="{StaticResource Chip}" Background="#12302A"><TextBlock x:Name="GpuChip" Text="" Foreground="#5BF0B0" FontSize="11" FontWeight="SemiBold"/></Border>
                      <StackPanel Margin="0,56,0,0">
                        <TextBlock Style="{StaticResource Label}" Text="Placa de vídeo"/>
                        <TextBlock x:Name="GpuText" Style="{StaticResource Value}" Text="..." Margin="0,3,0,0"/>
                      </StackPanel>
                    </Grid>
                  </Border>
                  <Border Style="{StaticResource CardStyle}" Margin="4,0">
                    <Grid>
                      <Border Style="{StaticResource IconTile}" Background="#26193F" HorizontalAlignment="Left" VerticalAlignment="Top">
                        <Viewbox Width="20" Height="20"><Grid Width="24" Height="24"><Path Style="{StaticResource Icon}" Stroke="#C084FC" Data="M3 7 H21 V16 H3 Z M7 7 V16 M11 7 V16 M15 7 V16 M5 16 V19 M19 16 V19"/></Grid></Viewbox>
                      </Border>
                      <Border Style="{StaticResource Chip}" Background="#26193F"><TextBlock x:Name="RamChip" Text="" Foreground="#C084FC" FontSize="11" FontWeight="SemiBold"/></Border>
                      <StackPanel Margin="0,56,0,0">
                        <TextBlock Style="{StaticResource Label}" Text="Memória"/>
                        <TextBlock x:Name="RamText" Style="{StaticResource Value}" Text="..." Margin="0,3,0,0"/>
                      </StackPanel>
                    </Grid>
                  </Border>
                  <Border Style="{StaticResource CardStyle}" Margin="8,0,0,0">
                    <Grid>
                      <Border Style="{StaticResource IconTile}" Background="#33220F" HorizontalAlignment="Left" VerticalAlignment="Top">
                        <Viewbox Width="20" Height="20"><Grid Width="24" Height="24"><Path Style="{StaticResource Icon}" Stroke="#F5B14C" Data="M22 13 H2 M5.5 5 H18.5 L22 13 V18 A2 2 0 0 1 20 20 H4 A2 2 0 0 1 2 18 V13 Z M6 16.5 H6.1 M10 16.5 H10.1"/></Grid></Viewbox>
                      </Border>
                      <Border Style="{StaticResource Chip}" Background="#33220F"><TextBlock x:Name="DiskChip" Text="" Foreground="#F5B14C" FontSize="11" FontWeight="SemiBold"/></Border>
                      <StackPanel Margin="0,56,0,0">
                        <TextBlock Style="{StaticResource Label}" Text="Armazenamento"/>
                        <TextBlock x:Name="DiskText" Style="{StaticResource Value}" Text="..." Margin="0,3,0,0"/>
                      </StackPanel>
                    </Grid>
                  </Border>
                </UniformGrid>

                <!-- Sistema e resumo -->
                <Grid Margin="0,16,0,0">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>
                  <Border Grid.Column="0" Style="{StaticResource CardStyle}">
                    <StackPanel>
                      <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <Border Style="{StaticResource IconTile}" Background="#2A1830">
                          <Viewbox Width="20" Height="20"><Grid Width="24" Height="24"><Path Style="{StaticResource Icon}" Stroke="#F472B6" Data="M3 4 H21 V16 H3 Z M8 20 H16 M12 16 V20"/></Grid></Viewbox>
                        </Border>
                        <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                          <TextBlock Style="{StaticResource H2}" Text="Sistema"/>
                          <TextBlock Style="{StaticResource Label}" Text="Windows e disco principal"/>
                        </StackPanel>
                      </StackPanel>
                      <Grid Height="38"><TextBlock Style="{StaticResource RowLabel}" Text="Windows"/><TextBlock x:Name="OsText" Style="{StaticResource RowValue}" Text="..."/></Grid>
                      <Border Height="1" Background="#1F2940"/>
                      <Grid Height="38"><TextBlock Style="{StaticResource RowLabel}" Text="Versão"/><TextBlock x:Name="OsVersionText" Style="{StaticResource RowValue}" Text="..."/></Grid>
                      <Border Height="1" Background="#1F2940"/>
                      <Grid Height="38"><TextBlock Style="{StaticResource RowLabel}" Text="Build"/><TextBlock x:Name="OsBuildText" Style="{StaticResource RowValue}" Text="..."/></Grid>
                      <Border Height="1" Background="#1F2940"/>
                      <Grid Height="38"><TextBlock Style="{StaticResource RowLabel}" Text="Disco"/><TextBlock x:Name="DiskModelText" Style="{StaticResource RowValue}" Text="..."/></Grid>
                    </StackPanel>
                  </Border>
                  <Border Grid.Column="2" Style="{StaticResource CardStyle}">
                    <StackPanel>
                      <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <Border Style="{StaticResource IconTile}" Background="#12302A">
                          <Viewbox Width="20" Height="20"><Grid Width="24" Height="24"><Path Style="{StaticResource Icon}" Stroke="#5BF0B0" Data="M3 12 H7 L10 5 L14 19 L17 12 H21"/></Grid></Viewbox>
                        </Border>
                        <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                          <TextBlock Style="{StaticResource H2}" Text="Resumo"/>
                          <TextBlock Style="{StaticResource Label}" Text="O que já está ajustado"/>
                        </StackPanel>
                      </StackPanel>
                      <Grid Height="38"><TextBlock Style="{StaticResource RowLabel}" Text="Ajustes ativos"/><TextBlock x:Name="StatActive" Style="{StaticResource RowValue}" Text="..."/></Grid>
                      <Border Height="1" Background="#1F2940"/>
                      <Grid Height="38"><TextBlock Style="{StaticResource RowLabel}" Text="Último ponto de restauração"/><TextBlock x:Name="StatRestore" Style="{StaticResource RowValue}" Text="..."/></Grid>
                      <Border Height="1" Background="#1F2940"/>
                      <Grid Height="38"><TextBlock Style="{StaticResource RowLabel}" Text="Podem ser desfeitos"/><TextBlock x:Name="StatUndo" Style="{StaticResource RowValue}" Text="..."/></Grid>
                      <Border Height="1" Background="#1F2940"/>
                      <Grid Height="38"><TextBlock Style="{StaticResource RowLabel}" Text="Atualização"/><TextBlock x:Name="StatUpdate" Style="{StaticResource RowValue}" Text="Verificando..."/></Grid>
                    </StackPanel>
                  </Border>
                </Grid>
              </StackPanel>
            </ScrollViewer>

            <!-- Otimizações -->
            <DockPanel x:Name="PageTweaks" Visibility="Collapsed">
              <StackPanel DockPanel.Dock="Top" Margin="0,0,10,0">
                <TextBlock Style="{StaticResource H1}" Text="Otimizações"/>
                <TextBlock Style="{StaticResource Sub}" Text="Marque o que quer aplicar ou reverter. Os recomendados são os mesmos do botão Otimizar agora."/>
                <WrapPanel Margin="0,0,0,8">
                  <Button x:Name="BtnApplySelected" Style="{StaticResource PrimaryButton}" Content="Aplicar selecionadas" Margin="0,0,10,8"/>
                  <Button x:Name="BtnRevertSelected" Style="{StaticResource SecondaryButton}" Content="Reverter selecionadas" Margin="0,0,10,8"/>
                  <Button x:Name="BtnSelectRecommended" Style="{StaticResource SecondaryButton}" Content="Marcar recomendadas" Margin="0,0,10,8"/>
                  <Button x:Name="BtnSelectAll" Style="{StaticResource SecondaryButton}" Content="Marcar todas" Margin="0,0,10,8"/>
                  <Button x:Name="BtnSelectNone" Style="{StaticResource SecondaryButton}" Content="Desmarcar" Margin="0,0,10,8"/>
                </WrapPanel>
              </StackPanel>
              <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="TweakList" Margin="0,0,10,16"/>
              </ScrollViewer>
            </DockPanel>

            <!-- Limpeza -->
            <ScrollViewer x:Name="PageClean" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" Padding="0,0,10,0">
              <StackPanel Margin="0,0,0,16">
                <DockPanel>
                  <Button x:Name="BtnCleanAll" DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" VerticalAlignment="Top">
                    <StackPanel Orientation="Horizontal">
                      <Viewbox Width="16" Height="16"><Grid Width="24" Height="24"><Path Style="{StaticResource Icon}" Stroke="White" StrokeThickness="2.2" Data="M11 3 L12.8 8.2 L18 10 L12.8 11.8 L11 17 L9.2 11.8 L4 10 L9.2 8.2 Z"/></Grid></Viewbox>
                      <TextBlock Text="Limpar tudo" Margin="8,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                  </Button>
                  <StackPanel>
                    <TextBlock Style="{StaticResource H1}" Text="Limpeza"/>
                    <TextBlock Style="{StaticResource Sub}" Text="Libera espaço e tira do caminho arquivos que o Windows acumula. Arquivos em uso são mantidos."/>
                  </StackPanel>
                </DockPanel>
                <UniformGrid Columns="2">
                  <Border Style="{StaticResource CardStyle}" Margin="0,0,8,16">
                    <DockPanel>
                      <Border DockPanel.Dock="Left" Style="{StaticResource IconTile}" Background="#33220F" VerticalAlignment="Top">
                        <Viewbox Width="20" Height="20"><Grid Width="24" Height="24"><Path Style="{StaticResource Icon}" Stroke="#F5B14C" Data="M3 6 H21 M8 6 V4 H16 V6 M6 6 L7 20 H17 L18 6 M10 10 V16 M14 10 V16"/></Grid></Viewbox>
                      </Border>
                      <StackPanel Margin="16,0,0,0">
                        <TextBlock Style="{StaticResource H2}" Text="Arquivos temporários"/>
                        <TextBlock Text="Pastas TEMP do usuário e do Windows: sobras de instalações e programas." Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,6,0,14"/>
                        <Button x:Name="BtnCleanTemp" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left" Content="Limpar"/>
                      </StackPanel>
                    </DockPanel>
                  </Border>
                  <Border Style="{StaticResource CardStyle}" Margin="8,0,0,16">
                    <DockPanel>
                      <Border DockPanel.Dock="Left" Style="{StaticResource IconTile}" Background="#2A1830" VerticalAlignment="Top">
                        <Viewbox Width="20" Height="20"><Grid Width="24" Height="24"><Path Style="{StaticResource Icon}" Stroke="#F472B6" Data="M3 5 H21 V19 H3 Z M3 15 L8 10 L13 15 M12 14 L15 11 L21 17 M15.5 8 H15.6"/></Grid></Viewbox>
                      </Border>
                      <StackPanel Margin="16,0,0,0">
                        <TextBlock Style="{StaticResource H2}" Text="Cache de miniaturas"/>
                        <TextBlock Text="Miniaturas e ícones que o Explorer guarda. O Windows recria sozinho quando precisa." Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,6,0,14"/>
                        <Button x:Name="BtnCleanThumbs" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left" Content="Limpar"/>
                      </StackPanel>
                    </DockPanel>
                  </Border>
                  <Border Style="{StaticResource CardStyle}" Margin="0,0,8,16">
                    <DockPanel>
                      <Border DockPanel.Dock="Left" Style="{StaticResource IconTile}" Background="#26193F" VerticalAlignment="Top">
                        <Viewbox Width="20" Height="20"><Grid Width="24" Height="24"><Path Style="{StaticResource Icon}" Stroke="#C084FC" Data="M12 3 V15 M7 10 L12 15 L17 10 M4 19 H20"/></Grid></Viewbox>
                      </Border>
                      <StackPanel Margin="16,0,0,0">
                        <TextBlock Style="{StaticResource H2}" Text="Cache do Windows Update"/>
                        <TextBlock Text="Atualizações já baixadas e instaladas. Costuma ocupar bastante espaço." Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,6,0,14"/>
                        <Button x:Name="BtnCleanUpdate" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left" Content="Limpar"/>
                      </StackPanel>
                    </DockPanel>
                  </Border>
                  <Border Style="{StaticResource CardStyle}" Margin="8,0,0,16">
                    <DockPanel>
                      <Border DockPanel.Dock="Left" Style="{StaticResource IconTile}" Background="#12302A" VerticalAlignment="Top">
                        <Viewbox Width="20" Height="20"><Grid Width="24" Height="24"><Path Style="{StaticResource Icon}" Stroke="#5BF0B0" Data="M4 7 H20 L18.5 20 H5.5 Z M2 7 H22 M9 3 H15 M9 11 V16 M15 11 V16"/></Grid></Viewbox>
                      </Border>
                      <StackPanel Margin="16,0,0,0">
                        <TextBlock Style="{StaticResource H2}" Text="Lixeira"/>
                        <TextBlock Text="Esvazia a Lixeira de todos os discos. Depois disso os arquivos não podem ser recuperados." Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,6,0,14"/>
                        <Button x:Name="BtnCleanBin" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left" Content="Esvaziar"/>
                      </StackPanel>
                    </DockPanel>
                  </Border>
                  <Border Style="{StaticResource CardStyle}" Margin="0,0,8,16">
                    <DockPanel>
                      <Border DockPanel.Dock="Left" Style="{StaticResource IconTile}" Background="#172748" VerticalAlignment="Top">
                        <Viewbox Width="20" Height="20"><Grid Width="24" Height="24"><Path Style="{StaticResource Icon}" Stroke="#60A5FA" Data="M12 3 A9 9 0 1 0 12 21 A9 9 0 1 0 12 3 Z M3 12 H21 M12 3 C14.5 5.7 15.8 8.7 15.8 12 C15.8 15.3 14.5 18.3 12 21 M12 3 C9.5 5.7 8.2 8.7 8.2 12 C8.2 15.3 9.5 18.3 12 21"/></Grid></Viewbox>
                      </Border>
                      <StackPanel Margin="16,0,0,0">
                        <TextBlock Style="{StaticResource H2}" Text="Cache DNS"/>
                        <TextBlock Text="Resolve problemas de conexão com servidores de jogo que mudaram de endereço." Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,6,0,14"/>
                        <Button x:Name="BtnFlushDns" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left" Content="Limpar DNS"/>
                      </StackPanel>
                    </DockPanel>
                  </Border>
                </UniformGrid>
              </StackPanel>
            </ScrollViewer>

            <!-- Restauração -->
            <ScrollViewer x:Name="PageRestore" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" Padding="0,0,10,0">
              <StackPanel Margin="0,0,0,16">
                <TextBlock Style="{StaticResource H1}" Text="Restauração"/>
                <TextBlock Style="{StaticResource Sub}" Text="Duas camadas de segurança: o backup do Overclutch, que desfaz só o que ele mudou, e os pontos de restauração do Windows."/>
                <UniformGrid Columns="2">
                  <Border Style="{StaticResource CardStyle}" Margin="0,0,8,16">
                    <DockPanel>
                      <Border DockPanel.Dock="Left" Style="{StaticResource IconTile}" Background="#12302A" VerticalAlignment="Top">
                        <Viewbox Width="20" Height="20"><Grid Width="24" Height="24"><Path Style="{StaticResource Icon}" Stroke="#5BF0B0" Data="M12 3 L4 6 V12 C4 16.5 7.4 20.3 12 21 C16.6 20.3 20 16.5 20 12 V6 Z M12 9 V15 M9 12 H15"/></Grid></Viewbox>
                      </Border>
                      <StackPanel Margin="16,0,0,0">
                        <TextBlock Style="{StaticResource H2}" Text="Ponto de restauração"/>
                        <TextBlock Text="Cria um ponto de restauração do Windows agora ou abre a tela para voltar a um anterior." Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,6,0,14"/>
                        <WrapPanel>
                          <Button x:Name="BtnRestorePoint" Style="{StaticResource PrimaryButton}" Content="Criar agora" Margin="0,0,10,0"/>
                          <Button x:Name="BtnOpenRestore" Style="{StaticResource SecondaryButton}" Content="Abrir Restauração"/>
                        </WrapPanel>
                      </StackPanel>
                    </DockPanel>
                  </Border>
                  <Border Style="{StaticResource CardStyle}" Margin="8,0,0,16">
                    <DockPanel>
                      <Border DockPanel.Dock="Left" Style="{StaticResource IconTile}" Background="#26193F" VerticalAlignment="Top">
                        <Viewbox Width="20" Height="20"><Grid Width="24" Height="24"><Path Style="{StaticResource Icon}" Stroke="#C084FC" Data="M3 12 A9 9 0 1 0 6 5.3 L3 8 M3 3 V8 H8"/></Grid></Viewbox>
                      </Border>
                      <StackPanel Margin="16,0,0,0">
                        <TextBlock Style="{StaticResource H2}" Text="Desfazer otimizações"/>
                        <TextBlock x:Name="BackupInfo" Text="..." Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,6,0,14"/>
                        <Button x:Name="BtnUndoAllRestore" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left" Content="Desfazer todas as otimizações"/>
                      </StackPanel>
                    </DockPanel>
                  </Border>
                </UniformGrid>
                <Border Style="{StaticResource CardStyle}">
                  <StackPanel>
                    <TextBlock Style="{StaticResource H2}" Text="Pontos de restauração do Windows"/>
                    <TextBlock Style="{StaticResource Label}" Text="Os mais recentes primeiro" Margin="0,2,0,10"/>
                    <StackPanel x:Name="RestoreList">
                      <TextBlock Text="Carregando..." Foreground="{StaticResource Muted}"/>
                    </StackPanel>
                  </StackPanel>
                </Border>
              </StackPanel>
            </ScrollViewer>

            <!-- Configurações -->
            <ScrollViewer x:Name="PageSettings" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" Padding="0,0,10,0">
              <StackPanel Margin="0,0,0,16">
                <TextBlock Style="{StaticResource H1}" Text="Configurações"/>
                <TextBlock Style="{StaticResource Sub}" Text="Preferências do Overclutch, atualizações e dados."/>
                <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                  <StackPanel>
                    <TextBlock Style="{StaticResource H2}" Text="Geral" Margin="0,0,0,6"/>
                    <DockPanel Margin="0,8">
                      <CheckBox x:Name="ToggleCheckUpdates" DockPanel.Dock="Right" Style="{StaticResource Toggle}" VerticalAlignment="Center"/>
                      <StackPanel Margin="0,0,20,0">
                        <TextBlock Text="Verificar atualizações ao abrir" Foreground="White" FontSize="14"/>
                        <TextBlock Text="Consulta o GitHub em segundo plano e avisa quando sair uma versão nova." Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                      </StackPanel>
                    </DockPanel>
                    <Border Height="1" Background="#1F2940" Margin="0,6"/>
                    <DockPanel Margin="0,8">
                      <CheckBox x:Name="ToggleRestoreBefore" DockPanel.Dock="Right" Style="{StaticResource Toggle}" VerticalAlignment="Center"/>
                      <StackPanel Margin="0,0,20,0">
                        <TextBlock Text="Criar ponto de restauração antes de otimizar" Foreground="White" FontSize="14"/>
                        <TextBlock Text="Recomendado. O botão Otimizar agora cria um ponto do Windows antes de mudar qualquer coisa." Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                      </StackPanel>
                    </DockPanel>
                  </StackPanel>
                </Border>
                <UniformGrid Columns="2">
                  <Border Style="{StaticResource CardStyle}" Margin="0,0,8,16">
                    <DockPanel>
                      <Border DockPanel.Dock="Left" Style="{StaticResource IconTile}" Background="#26193F" VerticalAlignment="Top">
                        <Viewbox Width="20" Height="20"><Grid Width="24" Height="24"><Path Style="{StaticResource Icon}" Stroke="#C084FC" Data="M21 12 A9 9 0 1 1 18 5.3 L21 8 M21 3 V8 H16"/></Grid></Viewbox>
                      </Border>
                      <StackPanel Margin="16,0,0,0">
                        <TextBlock Style="{StaticResource H2}" Text="Atualizações"/>
                        <TextBlock x:Name="UpdateInfo" Text="Confere no GitHub se há uma versão nova do Overclutch." Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,6,0,14"/>
                        <Button x:Name="BtnCheckUpdate" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left" Content="Verificar agora"/>
                      </StackPanel>
                    </DockPanel>
                  </Border>
                  <Border Style="{StaticResource CardStyle}" Margin="8,0,0,16">
                    <DockPanel>
                      <Border DockPanel.Dock="Left" Style="{StaticResource IconTile}" Background="#2A1830" VerticalAlignment="Top">
                        <Viewbox Width="20" Height="20"><Grid Width="24" Height="24"><Path Style="{StaticResource Icon}" Stroke="#F472B6" Data="M3 7 A2 2 0 0 1 5 5 H9 L11 7 H19 A2 2 0 0 1 21 9 V17 A2 2 0 0 1 19 19 H5 A2 2 0 0 1 3 17 Z"/></Grid></Viewbox>
                      </Border>
                      <StackPanel Margin="16,0,0,0">
                        <TextBlock Style="{StaticResource H2}" Text="Dados e registro"/>
                        <TextBlock Text="Backup dos valores originais, configurações e o registro de tudo o que o app fez." Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,6,0,14"/>
                        <WrapPanel>
                          <Button x:Name="BtnOpenData" Style="{StaticResource SecondaryButton}" Content="Abrir pasta" Margin="0,0,10,0"/>
                          <Button x:Name="BtnOpenLog" Style="{StaticResource SecondaryButton}" Content="Ver registro"/>
                        </WrapPanel>
                      </StackPanel>
                    </DockPanel>
                  </Border>
                </UniformGrid>
                <Border Style="{StaticResource CardStyle}">
                  <DockPanel>
                    <Image x:Name="AboutLogo" DockPanel.Dock="Left" Width="44" Height="44" VerticalAlignment="Top"/>
                    <StackPanel Margin="16,0,0,0">
                      <TextBlock x:Name="AboutVersion" Style="{StaticResource H2}" Text="Overclutch"/>
                      <TextBlock Text="Otimizador de Windows para jogos. Grátis e de código aberto, sob licença MIT." Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,4,0,14"/>
                      <Button x:Name="AboutGitHub" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left" Content="Ver o código no GitHub"/>
                    </StackPanel>
                  </DockPanel>
                </Border>
              </StackPanel>
            </ScrollViewer>
          </Grid>

          <!-- Barra de status -->
          <Border Grid.Row="2" Background="#0A0F1B" BorderBrush="#161E32" BorderThickness="0,1,0,0" Padding="36,9">
            <DockPanel>
              <ProgressBar x:Name="BusyBar" DockPanel.Dock="Right" Width="160" Height="5" IsIndeterminate="False"
                           Background="#1F2940" Foreground="#8B5CF6" BorderThickness="0" Visibility="Hidden"/>
              <TextBlock x:Name="StatusText" Text="Pronto." Foreground="{StaticResource Muted}" FontSize="12" VerticalAlignment="Center"/>
            </DockPanel>
          </Border>
        </Grid>
      </Grid>
    </Grid>
  </Border>
</Window>
