<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Overclutch" Width="1120" Height="740" MinWidth="960" MinHeight="620"
        WindowStartupLocation="CenterScreen" Background="#0B0D12" Foreground="#E7E9F0"
        FontFamily="Segoe UI" FontSize="13" UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
  <Window.Resources>
    <SolidColorBrush x:Key="Card" Color="#141821"/>
    <SolidColorBrush x:Key="CardBorder" Color="#232838"/>
    <SolidColorBrush x:Key="Muted" Color="#8A90A2"/>
    <LinearGradientBrush x:Key="AccentGradient" StartPoint="0,0" EndPoint="1,1">
      <GradientStop Color="#8B5CF6" Offset="0"/>
      <GradientStop Color="#06B6D4" Offset="1"/>
    </LinearGradientBrush>

    <Style x:Key="NavButton" TargetType="Button">
      <Setter Property="Foreground" Value="#B8BDCC"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="Height" Value="42"/>
      <Setter Property="Margin" Value="12,2"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="8" Padding="16,0">
              <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Left"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="#1C2130"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="PrimaryButton" TargetType="Button">
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="Background" Value="{StaticResource AccentGradient}"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Padding" Value="18,10"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="10" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Opacity" Value="0.88"/></Trigger>
              <Trigger Property="IsPressed" Value="True"><Setter TargetName="Bd" Property="Opacity" Value="0.75"/></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Bd" Property="Opacity" Value="0.4"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="SecondaryButton" TargetType="Button">
      <Setter Property="Foreground" Value="#E7E9F0"/>
      <Setter Property="Background" Value="#1A1F2B"/>
      <Setter Property="BorderBrush" Value="#2A3042"/>
      <Setter Property="Padding" Value="16,9"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="1" CornerRadius="9" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Background" Value="#232838"/></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Bd" Property="Opacity" Value="0.4"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="SelectBox" TargetType="CheckBox">
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="CheckBox">
            <Border x:Name="Box" Width="22" Height="22" CornerRadius="6" Background="#0F1219" BorderBrush="#3A4158" BorderThickness="1.5">
              <Path x:Name="Mark" Data="M 5,11 L 9,15 L 17,6" Stroke="White" StrokeThickness="2.4"
                    StrokeStartLineCap="Round" StrokeEndLineCap="Round" Visibility="Collapsed"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Box" Property="Background" Value="#8B5CF6"/>
                <Setter TargetName="Box" Property="BorderBrush" Value="#8B5CF6"/>
                <Setter TargetName="Mark" Property="Visibility" Value="Visible"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="CardStyle" TargetType="Border">
      <Setter Property="Background" Value="{StaticResource Card}"/>
      <Setter Property="BorderBrush" Value="{StaticResource CardBorder}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="14"/>
      <Setter Property="Padding" Value="22"/>
    </Style>

    <Style x:Key="H1" TargetType="TextBlock">
      <Setter Property="FontSize" Value="26"/>
      <Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="Foreground" Value="White"/>
    </Style>
    <Style x:Key="Sub" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource Muted}"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
      <Setter Property="Margin" Value="0,6,0,20"/>
    </Style>
    <Style x:Key="Label" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource Muted}"/>
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Margin" Value="0,12,0,2"/>
    </Style>
    <Style x:Key="Value" TargetType="TextBlock">
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
  </Window.Resources>

  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="230"/>
      <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>

    <!-- Barra lateral -->
    <Border Grid.Column="0" Background="#0F1219" BorderBrush="#1C2130" BorderThickness="0,0,1,0">
      <DockPanel>
        <StackPanel DockPanel.Dock="Top" Margin="26,28,20,26" Orientation="Horizontal">
          <Border Width="36" Height="36" CornerRadius="10" Background="{StaticResource AccentGradient}">
            <TextBlock Text="OC" FontSize="15" FontWeight="Black" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
            <TextBlock Text="Overclutch" FontSize="18" FontWeight="Bold" Foreground="White"/>
            <TextBlock x:Name="VersionText" Text="v1.0.0" FontSize="11" Foreground="{StaticResource Muted}"/>
          </StackPanel>
        </StackPanel>
        <Border DockPanel.Dock="Bottom" Margin="16,0,16,20" Padding="12,10" CornerRadius="8" Background="#141821">
          <TextBlock x:Name="ModeText" Text="Administrador" FontSize="11" Foreground="#4ADE80" TextWrapping="Wrap"/>
        </Border>
        <StackPanel>
          <Button x:Name="NavHome"   Style="{StaticResource NavButton}" Content="⚡  Início"/>
          <Button x:Name="NavTweaks" Style="{StaticResource NavButton}" Content="⚙  Otimizações"/>
          <Button x:Name="NavGames"  Style="{StaticResource NavButton}" Content="🎮  Jogos"/>
          <Button x:Name="NavTools"  Style="{StaticResource NavButton}" Content="🧰  Ferramentas"/>
          <Button x:Name="NavLog"    Style="{StaticResource NavButton}" Content="📄  Registro"/>
        </StackPanel>
      </DockPanel>
    </Border>

    <!-- Conteúdo -->
    <Grid Grid.Column="1">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>

      <!-- Faixa de atualização: aparece quando há versão nova no GitHub -->
      <Border x:Name="UpdateBanner" Grid.Row="0" Visibility="Collapsed" Margin="34,20,34,0" Padding="18,12"
              CornerRadius="10" Background="#1D1838" BorderBrush="#8B5CF6" BorderThickness="1">
        <DockPanel>
          <Button x:Name="BtnUpdateNow" DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Padding="16,8" Content="Atualizar agora"/>
          <Button x:Name="BtnUpdateLater" DockPanel.Dock="Right" Style="{StaticResource SecondaryButton}" Padding="14,7" Margin="0,0,10,0" Content="Depois"/>
          <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
            <TextBlock x:Name="UpdateTitle" Text="Nova versão disponível" Foreground="White" FontWeight="SemiBold" FontSize="14"/>
            <TextBlock x:Name="UpdateDetail" Text="" Foreground="#B8BDCC" FontSize="12" TextWrapping="Wrap"/>
          </StackPanel>
        </DockPanel>
      </Border>

      <Grid x:Name="ContentHost" Grid.Row="1" Margin="34,30,34,10">

        <!-- Início -->
        <ScrollViewer x:Name="PageHome" VerticalScrollBarVisibility="Auto">
          <StackPanel>
            <TextBlock Style="{StaticResource H1}" Text="Otimize seu PC em 1 clique"/>
            <TextBlock Style="{StaticResource Sub}" Text="Ajustes testados do Windows para mais FPS e menos input lag. Tudo é salvo antes de mudar, então dá para desfazer a qualquer momento."/>
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.15*"/>
                <ColumnDefinition Width="18"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <Border Style="{StaticResource CardStyle}" Grid.Column="0">
                <StackPanel>
                  <TextBlock Style="{StaticResource Label}" Margin="0" Text="STATUS DA OTIMIZAÇÃO"/>
                  <TextBlock x:Name="ScoreText" Text="0%" FontSize="52" FontWeight="Black" Foreground="White" Margin="0,6,0,0"/>
                  <TextBlock x:Name="ScoreDetail" Text="0 de 0 ajustes ativos" Foreground="{StaticResource Muted}"/>
                  <ProgressBar x:Name="ScoreBar" Height="8" Margin="0,14,0,22" Minimum="0" Maximum="100" Value="0"
                               Background="#232838" Foreground="#8B5CF6" BorderThickness="0"/>
                  <Button x:Name="BtnBoost" Style="{StaticResource PrimaryButton}" Height="58" FontSize="17" Content="⚡  OTIMIZAR AGORA"/>
                  <Button x:Name="BtnUndoAll" Style="{StaticResource SecondaryButton}" Margin="0,10,0,0" Content="Desfazer todas as otimizações"/>
                  <TextBlock Foreground="{StaticResource Muted}" FontSize="11" Margin="0,14,0,0" TextWrapping="Wrap"
                             Text="Antes de aplicar, o Overclutch cria um ponto de restauração do Windows e salva os valores originais."/>
                </StackPanel>
              </Border>
              <Border Style="{StaticResource CardStyle}" Grid.Column="2">
                <StackPanel>
                  <TextBlock Style="{StaticResource Label}" Margin="0" Text="SEU PC"/>
                  <TextBlock Style="{StaticResource Label}" Text="PROCESSADOR"/>
                  <TextBlock x:Name="CpuText" Style="{StaticResource Value}" Text="..."/>
                  <TextBlock Style="{StaticResource Label}" Text="PLACA DE VÍDEO"/>
                  <TextBlock x:Name="GpuText" Style="{StaticResource Value}" Text="..."/>
                  <TextBlock Style="{StaticResource Label}" Text="MEMÓRIA"/>
                  <TextBlock x:Name="RamText" Style="{StaticResource Value}" Text="..."/>
                  <TextBlock Style="{StaticResource Label}" Text="SISTEMA"/>
                  <TextBlock x:Name="OsText" Style="{StaticResource Value}" Text="..."/>
                </StackPanel>
              </Border>
            </Grid>
            <UniformGrid Columns="3" Margin="0,18,0,0">
              <Border Style="{StaticResource CardStyle}" Margin="0,0,9,0" Padding="18">
                <StackPanel>
                  <TextBlock Text="FPS Boost" FontWeight="Bold" Foreground="White" FontSize="14"/>
                  <TextBlock Text="Energia, GPU e agendador do Windows ajustados para jogos." Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                </StackPanel>
              </Border>
              <Border Style="{StaticResource CardStyle}" Margin="4.5,0" Padding="18">
                <StackPanel>
                  <TextBlock Text="Menos latência" FontWeight="Bold" Foreground="White" FontSize="14"/>
                  <TextBlock Text="Mouse 1:1, rede sem limitação e menos processos de fundo." Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                </StackPanel>
              </Border>
              <Border Style="{StaticResource CardStyle}" Margin="9,0,0,0" Padding="18">
                <StackPanel>
                  <TextBlock Text="Boost por jogo" FontWeight="Bold" Foreground="White" FontSize="14"/>
                  <TextBlock Text="GPU dedicada e prioridade alta para cada jogo detectado." Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                </StackPanel>
              </Border>
            </UniformGrid>
          </StackPanel>
        </ScrollViewer>

        <!-- Otimizações -->
        <DockPanel x:Name="PageTweaks" Visibility="Collapsed">
          <StackPanel DockPanel.Dock="Top">
            <TextBlock Style="{StaticResource H1}" Text="Otimizações"/>
            <TextBlock Style="{StaticResource Sub}" Text="Marque o que quer aplicar ou reverter. Os itens recomendados são os mesmos do botão Otimizar Agora."/>
            <WrapPanel Margin="0,0,0,10">
              <Button x:Name="BtnApplySelected" Style="{StaticResource PrimaryButton}" Content="Aplicar selecionadas" Margin="0,0,10,8"/>
              <Button x:Name="BtnRevertSelected" Style="{StaticResource SecondaryButton}" Content="Reverter selecionadas" Margin="0,0,10,8"/>
              <Button x:Name="BtnSelectRecommended" Style="{StaticResource SecondaryButton}" Content="Marcar recomendadas" Margin="0,0,10,8"/>
              <Button x:Name="BtnSelectAll" Style="{StaticResource SecondaryButton}" Content="Marcar todas" Margin="0,0,10,8"/>
              <Button x:Name="BtnSelectNone" Style="{StaticResource SecondaryButton}" Content="Desmarcar" Margin="0,0,10,8"/>
            </WrapPanel>
          </StackPanel>
          <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="TweakList" Margin="0,0,8,0"/>
          </ScrollViewer>
        </DockPanel>

        <!-- Jogos -->
        <DockPanel x:Name="PageGames" Visibility="Collapsed">
          <StackPanel DockPanel.Dock="Top">
            <TextBlock Style="{StaticResource H1}" Text="Jogos"/>
            <TextBlock Style="{StaticResource Sub}" Text="Para cada jogo: força a GPU de alto desempenho e deixa o processo com prioridade alta de CPU sempre que ele abrir."/>
            <WrapPanel Margin="0,0,0,10">
              <Button x:Name="BtnBoostGames" Style="{StaticResource PrimaryButton}" Content="Otimizar todos os jogos" Margin="0,0,10,8"/>
              <Button x:Name="BtnDetectGames" Style="{StaticResource SecondaryButton}" Content="Detectar jogos instalados" Margin="0,0,10,8"/>
              <Button x:Name="BtnAddGame" Style="{StaticResource SecondaryButton}" Content="Adicionar .exe manualmente" Margin="0,0,10,8"/>
              <Button x:Name="BtnUnboostGames" Style="{StaticResource SecondaryButton}" Content="Remover boost dos jogos" Margin="0,0,10,8"/>
            </WrapPanel>
          </StackPanel>
          <ScrollViewer VerticalScrollBarVisibility="Auto">
            <WrapPanel x:Name="GameList" Margin="0,4,0,0"/>
          </ScrollViewer>
        </DockPanel>

        <!-- Ferramentas -->
        <ScrollViewer x:Name="PageTools" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
          <StackPanel>
            <TextBlock Style="{StaticResource H1}" Text="Ferramentas"/>
            <TextBlock Style="{StaticResource Sub}" Text="Ações rápidas de manutenção."/>
            <UniformGrid Columns="2">
              <Border Style="{StaticResource CardStyle}" Margin="0,0,9,18">
                <StackPanel>
                  <TextBlock Text="Limpar arquivos temporários" FontWeight="Bold" Foreground="White" FontSize="15"/>
                  <TextBlock Text="Apaga o conteúdo das pastas TEMP do usuário e do Windows. Arquivos em uso são ignorados." Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,6,0,14"/>
                  <Button x:Name="BtnCleanTemp" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left" Content="Limpar agora"/>
                </StackPanel>
              </Border>
              <Border Style="{StaticResource CardStyle}" Margin="9,0,0,18">
                <StackPanel>
                  <TextBlock Text="Limpar cache DNS" FontWeight="Bold" Foreground="White" FontSize="15"/>
                  <TextBlock Text="Resolve problemas de conexão com servidores de jogo que mudaram de endereço." Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,6,0,14"/>
                  <Button x:Name="BtnFlushDns" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left" Content="Limpar DNS"/>
                </StackPanel>
              </Border>
              <Border Style="{StaticResource CardStyle}" Margin="0,0,9,18">
                <StackPanel>
                  <TextBlock Text="Ponto de restauração" FontWeight="Bold" Foreground="White" FontSize="15"/>
                  <TextBlock Text="Cria um ponto de restauração do Windows agora ou abre a tela para voltar a um anterior." Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,6,0,14"/>
                  <WrapPanel>
                    <Button x:Name="BtnRestorePoint" Style="{StaticResource SecondaryButton}" Content="Criar agora" Margin="0,0,10,0"/>
                    <Button x:Name="BtnOpenRestore" Style="{StaticResource SecondaryButton}" Content="Abrir Restauração"/>
                  </WrapPanel>
                </StackPanel>
              </Border>
              <Border Style="{StaticResource CardStyle}" Margin="9,0,0,18">
                <StackPanel>
                  <TextBlock Text="Dados do Overclutch" FontWeight="Bold" Foreground="White" FontSize="15"/>
                  <TextBlock Text="Pasta com o backup dos valores originais, lista de jogos e registro de atividades." Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,6,0,14"/>
                  <Button x:Name="BtnOpenData" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left" Content="Abrir pasta"/>
                </StackPanel>
              </Border>
              <Border Style="{StaticResource CardStyle}" Margin="0,0,9,18">
                <StackPanel>
                  <TextBlock Text="Atualizações" FontWeight="Bold" Foreground="White" FontSize="15"/>
                  <TextBlock x:Name="UpdateInfo" Text="Confere no GitHub se há uma versão nova do Overclutch." Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,6,0,14"/>
                  <Button x:Name="BtnCheckUpdate" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left" Content="Verificar atualizações"/>
                </StackPanel>
              </Border>
            </UniformGrid>
          </StackPanel>
        </ScrollViewer>

        <!-- Registro -->
        <DockPanel x:Name="PageLog" Visibility="Collapsed">
          <StackPanel DockPanel.Dock="Top">
            <TextBlock Style="{StaticResource H1}" Text="Registro de atividades"/>
            <TextBlock Style="{StaticResource Sub}" Text="Tudo o que o Overclutch alterou nesta sessão."/>
          </StackPanel>
          <TextBox x:Name="LogBox" IsReadOnly="True" FontFamily="Consolas" FontSize="12" Background="#0F1219" Foreground="#C9CEDB"
                   BorderBrush="#232838" Padding="12" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>
        </DockPanel>
      </Grid>

      <!-- Barra de status -->
      <Border Grid.Row="2" Background="#0F1219" BorderBrush="#1C2130" BorderThickness="0,1,0,0" Padding="34,10">
        <DockPanel>
          <ProgressBar x:Name="BusyBar" DockPanel.Dock="Right" Width="160" Height="6" IsIndeterminate="False"
                       Background="#232838" Foreground="#8B5CF6" BorderThickness="0" Visibility="Hidden"/>
          <TextBlock x:Name="StatusText" Text="Pronto." Foreground="{StaticResource Muted}" VerticalAlignment="Center"/>
        </DockPanel>
      </Border>
    </Grid>
  </Grid>
</Window>
